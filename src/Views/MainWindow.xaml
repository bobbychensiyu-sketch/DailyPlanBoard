<Window x:Class="DailyPlanBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="每日计划看板"
        Width="350"
        Height="540"
        MinWidth="295"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="InvisibleThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="Transparent" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border Margin="4"
            CornerRadius="15"
            Background="#18000000"
            Padding="1.5">
    <Border x:Name="RootCard"
            CornerRadius="13.5"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrushKey}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Date & Progress -->
                <RowDefinition Height="Auto"/> <!-- Rollover Banner -->
                <RowDefinition Height="Auto"/> <!-- Quick Add -->
                <RowDefinition Height="*"/>    <!-- Task List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Draggable Header -->
            <Border Grid.Row="0"
                    Padding="14,11,10,8"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,7,0">
                            <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="每日计划"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="ModeBadgeBorder"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}"
                                Padding="6,1.5"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ModeBadgeText"
                                       Text="常驻桌面"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PinModeBtn"
                                Width="27" Height="26"
                                Margin="1,0"
                                Content="📌"
                                ToolTip="切换窗口层级：窗口置顶 / 常驻桌面 / 普通窗口"
                                Click="CyclePinMode_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="EdgeDockBtn"
                                Width="27" Height="26"
                                Margin="1,0"
                                Content="◧"
                                FontSize="13.5"
                                ToolTip="吸附贴边并收起为胶囊 (Ctrl+W)"
                                Click="CollapseToEdge_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="ThemeBtn"
                                Width="27" Height="26"
                                Margin="1,0"
                                Content="◐"
                                FontSize="13.5"
                                ToolTip="切换主题：暖纸 / 素白 / 松林 / 晚霞 / 墨夜"
                                Click="CycleTheme_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="SettingsBtn"
                                Width="27" Height="26"
                                Margin="1,0"
                                Content="⚙"
                                FontSize="13.5"
                                ToolTip="打开设置（吸附、外观、快捷键、防截屏等）"
                                Click="SettingsBtn_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="HideToTrayBtn"
                                Width="27" Height="26"
                                Margin="1,0,0,0"
                                Content="—"
                                FontSize="11"
                                ToolTip="隐藏到系统托盘（后台继续准点提醒）"
                                Click="HideToTray_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Date Navigation & Progress -->
            <Border Grid.Row="1"
                    Margin="12,0,12,8"
                    Padding="8,7"
                    CornerRadius="10"
                    Background="{DynamicResource SurfaceBgBrush}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="PrevDayBtn"
                                Content="◀"
                                Width="26" Height="24"
                                FontSize="11"
                                ToolTip="前一天"
                                Click="PrevDay_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="CalendarBtn"
                                DockPanel.Dock="Right"
                                Content="📅"
                                Width="26" Height="24"
                                FontSize="12"
                                Margin="2,0,0,0"
                                ToolTip="打开月历视图与区间导出 (Ctrl+M)"
                                Click="OpenCalendar_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <Button x:Name="NextDayBtn"
                                DockPanel.Dock="Right"
                                Content="▶"
                                Width="26" Height="24"
                                FontSize="11"
                                ToolTip="后一天"
                                Click="NextDay_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="DateLabel"
                                       Text="2026-11-19 周四"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Cursor="Hand"
                                       ToolTip="点击返回今天"
                                       MouseLeftButtonUp="JumpToday_Click"/>
                            <Button x:Name="TodayPillBtn"
                                    Content="回今天"
                                    Margin="6,0,0,0"
                                    Padding="6,1"
                                    FontSize="10.5"
                                    Visibility="Collapsed"
                                    Click="JumpTodayBtn_Click"
                                    Style="{DynamicResource ChipBtnStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Progress Bar -->
                    <Grid Margin="4,6,4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Height="5"
                                CornerRadius="3"
                                Background="{DynamicResource BorderBrushKey}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <Border x:Name="ProgressFill"
                                    HorizontalAlignment="Left"
                                    Width="0"
                                    CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="ProgressText"
                                   Grid.Column="1"
                                   Text="0 / 0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Past Unfinished Rollover Banner -->
            <Border x:Name="RolloverBanner"
                    Grid.Row="2"
                    Margin="12,0,12,8"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{DynamicResource AccentSoftBrush}"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="RolloverMoveBtn"
                            DockPanel.Dock="Right"
                            Content="移至今天"
                            Padding="8,2.5"
                            FontSize="11"
                            Click="Rollover_Click"
                            Style="{DynamicResource AccentBtnStyle}"/>
                    <TextBlock x:Name="RolloverText"
                               Text="过去有 1 项未完成"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 4. Quick Add Box -->
            <Border Grid.Row="3"
                    Margin="12,0,12,8"
                    Padding="8,7"
                    CornerRadius="10"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="QuickAddBox"
                                 FontSize="13"
                                 Padding="2,2,2,2"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 VerticalContentAlignment="Center"
                                 KeyDown="QuickAddBox_KeyDown"
                                 TextChanged="QuickAddBox_TextChanged"/>
                        <TextBlock x:Name="QuickAddPlaceholder"
                                   Text="写下计划，回车添加（如：15:30 开会）"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextCompletedBrush}"
                                   Margin="4,3,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <DockPanel Margin="0,7,0,0">
                        <Button x:Name="QuickAddBtn"
                                DockPanel.Dock="Right"
                                Content="+ 添加"
                                Padding="10,3.5"
                                FontSize="11.5"
                                Click="QuickAddBtn_Click"
                                Style="{DynamicResource AccentBtnStyle}"/>

                        <WrapPanel VerticalAlignment="Center">
                            <Button x:Name="QuickPriorityBtn"
                                    Content="● 普通"
                                    Margin="0,1,4,1"
                                    ToolTip="点击切换优先级：普通 / 重要 / 紧急"
                                    Click="QuickPriority_Click"
                                    Style="{DynamicResource ChipBtnStyle}"/>
                            <Button x:Name="QuickReminderBtn"
                                    Content="⏰ 提醒"
                                    Margin="0,1,4,1"
                                    ToolTip="快捷设置提醒时间"
                                    Click="QuickReminder_Click"
                                    Style="{DynamicResource ChipBtnStyle}"/>
                            <Button x:Name="QuickMilestoneBtn"
                                    Content="🎯 节点"
                                    Margin="0,1,4,1"
                                    ToolTip="设置计划节点日期（自动排入节点前每一天，显示倒计时，含提前3天/1天及当天紧急提醒）"
                                    Click="QuickMilestone_Click"
                                    Style="{DynamicResource ChipBtnStyle}"/>
                            <Button x:Name="QuickRepeatBtn"
                                    Content="🔁 每日"
                                    Margin="0,1,0,1"
                                    ToolTip="设为每日重复任务"
                                    Click="QuickRepeat_Click"
                                    Style="{DynamicResource ChipBtnStyle}"/>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 5. Task List -->
            <Grid Grid.Row="4" Margin="12,0,12,4">
                <ScrollViewer x:Name="TaskScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TaskListPanel"/>
                </ScrollViewer>

                <StackPanel x:Name="EmptyStatePanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="✨" FontSize="26" HorizontalAlignment="Center" Opacity="0.7"/>
                    <TextBlock x:Name="EmptyStateText"
                               Text="暂无计划，在上方添加第一项吧"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 6. Footer Bar + Resize Grip -->
            <Border Grid.Row="5"
                    Padding="12,6,6,8"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="0,1,0,0">
                <DockPanel>
                    <!-- Resize Grip -->
                    <primitives:Thumb x:Name="ResizeThumb"
                                      DockPanel.Dock="Right"
                                      Width="16" Height="16"
                                      Cursor="SizeNWSE"
                                      ToolTip="拖拽调整看板大小"
                                      DragStarted="OnResizeDragStarted"
                                      DragDelta="ResizeThumb_BR_DragDelta"
                                      DragCompleted="OnResizeDragCompleted">
                        <primitives:Thumb.Template>
                            <ControlTemplate TargetType="primitives:Thumb">
                                <Border Background="Transparent">
                                    <TextBlock Text="◢"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextCompletedBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"/>
                                </Border>
                            </ControlTemplate>
                        </primitives:Thumb.Template>
                    </primitives:Thumb>

                    <Button x:Name="ClearCompletedBtn"
                            DockPanel.Dock="Right"
                            Content="清理已完成"
                            FontSize="11"
                            Margin="0,0,6,0"
                            Padding="7,2"
                            Visibility="Collapsed"
                            Click="ClearCompleted_Click"
                            Style="{DynamicResource IconBtnStyle}"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FilterAllBtn" Content="全部" Margin="0,0,4,0" Click="Filter_Click" Tag="all" Style="{DynamicResource ChipBtnStyle}"/>
                        <Button x:Name="FilterActiveBtn" Content="待办" Margin="0,0,4,0" Click="Filter_Click" Tag="active" Style="{DynamicResource ChipBtnStyle}"/>
                        <Button x:Name="FilterDoneBtn" Content="已完成" Click="Filter_Click" Tag="done" Style="{DynamicResource ChipBtnStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
    </Border>

    <!-- 8 方向全边缘及角落拖拽拉伸控点 (覆盖在卡片边框上，透明响应) -->
    <primitives:Thumb x:Name="ResizeThumb_L"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Width="8" Margin="0,14,0,14"
                      Cursor="SizeWE"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_L_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_R"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Width="8" Margin="0,14,0,14"
                      Cursor="SizeWE"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_R_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_T"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Height="8" Margin="14,0,14,0"
                      Cursor="SizeNS"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_T_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_B"
                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                      Height="8" Margin="14,0,14,0"
                      Cursor="SizeNS"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_B_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_TL"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Width="14" Height="14"
                      Cursor="SizeNWSE"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_TL_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_TR"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="14" Height="14"
                      Cursor="SizeNESW"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_TR_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_BL"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Width="14" Height="14"
                      Cursor="SizeNESW"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_BL_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>

    <primitives:Thumb x:Name="ResizeThumb_BR"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="14" Height="14"
                      Cursor="SizeNWSE"
                      DragStarted="OnResizeDragStarted"
                      DragDelta="ResizeThumb_BR_DragDelta"
                      DragCompleted="OnResizeDragCompleted"
                      Style="{DynamicResource InvisibleThumbStyle}"/>
    </Grid>
</Window>

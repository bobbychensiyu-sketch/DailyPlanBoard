<Window x:Class="DailyPlanBoard.Views.CalendarOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日历总览与计划导出"
        Width="780"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Margin="4" CornerRadius="14" Background="#24000000" Padding="1.5">
        <Border CornerRadius="13"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="16,11,12,10"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <DockPanel>
                        <TextBlock x:Name="WinTitleText"
                                   Text="📅  日历总览与计划导出"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Width="28" Height="28"
                                Click="Close_Click"
                                Style="{DynamicResource IconBtnStyle}"/>
                    </DockPanel>
                </Border>

                <!-- Body: Left Calendar | Right Day Details + Range Export -->
                <Grid Grid.Row="1" Margin="14,12,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="355"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Month Calendar -->
                    <Border Grid.Column="0"
                            Padding="12"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceBgBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Month Nav -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Content="◀" Width="28" Height="26" FontSize="11" Click="PrevMonth_Click" Style="{DynamicResource IconBtnStyle}"/>
                                <Button x:Name="ThisMonthBtn" DockPanel.Dock="Right" Content="回本月" Padding="8,3" FontSize="11" Click="ThisMonth_Click" Style="{DynamicResource ChipBtnStyle}" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="▶" Width="28" Height="26" FontSize="11" Click="NextMonth_Click" Style="{DynamicResource IconBtnStyle}"/>
                                <TextBlock x:Name="MonthLabel"
                                           Text="2026年 11月"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Weekday Headers -->
                            <UniformGrid x:Name="WeekdayHeaderGrid" Grid.Row="1" Columns="7" Margin="0,0,0,6"/>

                            <!-- 6x7 Day Cells -->
                            <UniformGrid x:Name="CalendarGrid" Grid.Row="2" Rows="6" Columns="7"/>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Day Details & Date Range Export -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Selected Day Plans -->
                        <Border Grid.Row="0"
                                Padding="12"
                                CornerRadius="11"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Button x:Name="JumpBoardBtn"
                                            DockPanel.Dock="Right"
                                            Content="在主看板打开此日"
                                            Padding="9,3"
                                            FontSize="11"
                                            Click="JumpToBoard_Click"
                                            Style="{DynamicResource AccentBtnStyle}"/>
                                    <TextBlock x:Name="SelectedDayHeader"
                                               Text="2026-11-19 计划明细"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DayPlansPanel"/>
                                </ScrollViewer>
                                <TextBlock x:Name="EmptyDayText"
                                           Grid.Row="1"
                                           Text="当天暂无计划"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Date Range Stats & Export -->
                        <Border Grid.Row="2"
                                Padding="12"
                                CornerRadius="11"
                                Background="{DynamicResource SurfaceBgBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="ExportHeaderLabel"
                                               Text="区间统计与一键导出"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="PresetWeekBtn" Content="本周" Tag="week" Click="RangePreset_Click" Style="{DynamicResource ChipBtnStyle}" Margin="0,0,4,0"/>
                                        <Button x:Name="PresetMonthBtn" Content="本月" Tag="month" Click="RangePreset_Click" Style="{DynamicResource ChipBtnStyle}" Margin="0,0,4,0"/>
                                        <Button x:Name="Preset7DaysBtn" Content="近7天" Tag="7d" Click="RangePreset_Click" Style="{DynamicResource ChipBtnStyle}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FromLabel" Grid.Column="0" Text="开始" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <DatePicker x:Name="StartDatePicker" Grid.Column="1" FontSize="11.5" SelectedDateChanged="RangePicker_Changed"/>
                                    <TextBlock x:Name="ToLabel" Grid.Column="2" Text="至" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,5,0"/>
                                    <DatePicker x:Name="EndDatePicker" Grid.Column="3" FontSize="11.5" SelectedDateChanged="RangePicker_Changed"/>
                                </Grid>

                                <TextBlock x:Name="RangeStatsText"
                                           Text="共 0 项 · 已完成 0 · 未完成 0（完成率 0%）"
                                           FontSize="11.8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,9"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExportBtn"
                                            Grid.Column="0"
                                            Content="📤 一键导出报告 (.md / .csv)"
                                            Height="31"
                                            Click="Export_Click"
                                            Style="{DynamicResource AccentBtnStyle}"/>
                                    <Button x:Name="SendWeComBtn"
                                            Grid.Column="2"
                                            Content="💬 发送今日汇总到微信"
                                            Height="31"
                                            Padding="10,4"
                                            Click="SendWeComSummary_Click"
                                            Style="{DynamicResource SubtleBtnStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>

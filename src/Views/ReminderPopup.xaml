<Window x:Class="DailyPlanBoard.Views.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计划提醒"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Border Margin="4" CornerRadius="13.5" Background="#28000000" Padding="1.5">
    <Border x:Name="PopupCardBorder"
            CornerRadius="12"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5">
        <StackPanel Margin="15,13,15,14">
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="PopupHeaderTitle"
                           Text="⏰  每日计划提醒"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="24" Height="24"
                        Click="Dismiss_Click"
                        Style="{DynamicResource IconBtnStyle}"/>
                <TextBlock x:Name="TimeText"
                           DockPanel.Dock="Right"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
            </DockPanel>

            <TextBlock x:Name="TaskTitleText"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock x:Name="TaskNoteText"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,5,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
                <Button x:Name="SnoozeBtn"
                        Content="延后 10 分"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        Click="Snooze_Click"
                        Style="{DynamicResource SubtleBtnStyle}"/>
                <Button x:Name="DismissBtn"
                        Content="知道了"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        Click="Dismiss_Click"
                        Style="{DynamicResource SubtleBtnStyle}"/>
                <Button x:Name="CompleteBtn"
                        Content="✓ 标记完成"
                        Padding="11,5"
                        Click="Complete_Click"
                        Style="{DynamicResource AccentBtnStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </Border>
</Window>
